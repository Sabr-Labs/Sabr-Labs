---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FounderCard from '../components/FounderCard';
import Footer from '../components/Footer';
---

<Layout title="Founders - Sabr Labs">
  <Navbar client:load />

  <section class="py-20 bg-gradient-to-br from-brand-dark to-brand-navy">
    <div class="container mx-auto px-6 text-center text-white">
      <p class="text-brand-blue text-xs font-semibold uppercase tracking-widest mb-3">Our Team</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Meet Our Founders</h1>
      <p class="text-gray-300 max-w-2xl mx-auto leading-relaxed">
        The passionate minds behind Sabr Labs, dedicated to building technology that drives enterprise innovation.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <FounderCard
          client:load
          name="Ahmed"
          role="Co-Founder"
          initials="A"
          bio="Ahmed is passionate about creating technology solutions that address real-world problems. With a focus on innovation and user experience, he drives the vision and strategy at Sabr Labs."
        />

        <FounderCard
          client:load
          name="Ammaar"
          role="Co-Founder"
          initials="A"
          bio="Ammaar brings technical expertise and a keen eye for detail to every project. He is dedicated to building robust, scalable software that delivers meaningful value to users."
        />
      </div>
    </div>
  </section>

  <section class="py-20 bg-gradient-to-br from-brand-dark to-brand-navy text-white">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-8">Our Mission</h2>
        <p class="text-lg text-gray-300 leading-relaxed mb-6">
          Together, Ahmed and Ammaar founded Sabr Labs with a simple mission: to accelerate
          innovation through advanced data science and custom technology solutions for enterprises.
        </p>
        <p class="text-gray-400 leading-relaxed">
          We believe that great technology should be accessible, intuitive, and genuinely impactful.
          Every project we undertake is driven by this philosophy.
        </p>
        <div class="mt-10">
          <a
            href="/"
            class="inline-block bg-brand-blue text-white font-semibold px-8 py-3.5 rounded-lg hover:bg-blue-600 transition-colors"
          >
            View Our Projects
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer client:load />
</Layout>
